NEXT_PUBLIC_APP_NAME=DDC Admin
ADMIN_USERNAME=AdminDDC
ADMIN_PASSWORD=changeme
SESSION_SECRET=dev-change-me-to-a-long-random-string
# Optional extra admin. The starting admins and service@ddc.co.il are seeded in code.
ADMIN_OWNER_EMAIL=
# Firebase web app config. Local: this file as cms/.env (gitignored).
# Deploy: GitHub Actions secrets of the same names. See Project settings → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=control-applications-ddc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=control-applications-ddc
NEXT_PUBLIC_FIREBASE_APP_ID=
# Leave DATABASE_URL empty to use embedded PGlite (local disk or in-memory on Firebase)
# DATABASE_URL=postgres://user:pass@host/ddc_cms
PUBLIC_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret
# Live public site (resolves /assets/* links in admin)
PUBLIC_SITE_URL=https://ddc-cms.web.app
PUBLIC_SNAPSHOT_URL=https://ddc-cms.web.app/cms/public.json
# Optional Firestore doc path (default cms/public)
# CMS_SNAPSHOT_DOC=cms/public
