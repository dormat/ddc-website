{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.10"
  },
  "hosting": [
    {
      "target": "ddc-temp",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/assistant/**",
          "run": {
            "serviceId": "lt22-assistant",
            "region": "me-west1"
          }
        },
        {
          "source": "/cms/public.json",
          "run": {
            "serviceId": "ssrcontrolapplicationsa",
            "region": "us-central1"
          }
        },
        {
          "source": "/cms/public.json/**",
          "run": {
            "serviceId": "ssrcontrolapplicationsa",
            "region": "us-central1"
          }
        },
        {
          "source": "/",
          "destination": "/he/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        }
      ]
    },
    {
      "target": "ddc-temp2",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/assistant/**",
          "run": {
            "serviceId": "lt22-assistant",
            "region": "me-west1"
          }
        },
        {
          "source": "/",
          "destination": "/he/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        }
      ]
    },
    {
      "target": "ddc-cms",
      "public": "site",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api/assistant/**",
          "run": {
            "serviceId": "lt22-assistant",
            "region": "me-west1"
          }
        },
        {
          "source": "/cms/public.json",
          "run": {
            "serviceId": "ssrcontrolapplicationsa",
            "region": "us-central1"
          }
        },
        {
          "source": "/cms/public.json/**",
          "run": {
            "serviceId": "ssrcontrolapplicationsa",
            "region": "us-central1"
          }
        },
        {
          "source": "/",
          "destination": "/he/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "/cms/public.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ]
    },
    {
      "target": "ddc-admin",
      "source": ".firebase-cms-stage/admin",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "frameworksBackend": {
        "region": "us-central1",
        "memory": "1GiB",
        "maxInstances": 1
      }
    }
  ]
}
